BOT_TOKEN=replace_me
BOT_WHITELIST=123456789
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/leadmon
REDIS_URL=redis://redis:6379/0

# Core scan defaults
MONITOR_SCAN_MINUTES_MIN=30
MONITOR_SCAN_MINUTES_MAX=60
MUTUAL_JITTER_MIN_SECONDS=30
MUTUAL_JITTER_MAX_SECONDS=60

DYNAMIC_LIMIT_INITIAL=80
DYNAMIC_LIMIT_MIN=40
DYNAMIC_LIMIT_MAX=150
COOLDOWN_MIN_MINUTES=10
COOLDOWN_MAX_MINUTES=30
WORKER_TICK_SECONDS=5

TELETHON_MODE=mock

MONITOR_SOURCE_MODE=mock
BACKUP_ENABLED=true
BACKUP_EVERY_HOURS=24
BACKUP_OUTPUT_DIR=data/backups

HEALTH_CHECK_EVERY_MINUTES=30

MAX_GROUPS_PER_CYCLE=20
MAX_CANDIDATES_PER_GROUP=200
INTER_GROUP_DELAY_MIN_SECONDS=2
INTER_GROUP_DELAY_MAX_SECONDS=8
BACKUP_RETENTION_DAYS=14
